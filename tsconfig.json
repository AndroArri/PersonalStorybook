{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@j/*": ["src/js/*"],
      "src/*": ["src/*"],
      "assets/*": ["assets/*"],
      "resources/*": ["resources/*"]
    },
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
  },
  "exclude": ["node_modules", "public"]
}
